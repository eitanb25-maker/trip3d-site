ADMIN_SETUP_CODE=          # קוד הקמה סודי, לשימוש חד-פעמי בהרשמת המנהל

# מומלץ
SITE_URL=                  # https://your-site.netlify.app (נדרש לתצוגת שיתוף ולקישורים במיילים)
CONTACT_EMAIL=
RESEND_API_KEY=            # שליחת מיילים (אימות, קישור קסם, התראת שגיאות)
FROM_EMAIL=
NOTIFY_EMAIL=              # לאן נשלחות התראות מייל (שגיאות, דוחות)

# אופציונלי
